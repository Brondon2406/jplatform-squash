 <%@ page import="co.kozao.jcmsplugin.squashtm.model.squashimport.ImportSquashTmAnalysis" %>
 <%@ page import="co.kozao.jcmsplugin.squashtm.model.squashimport.ImportSquashTmResult" %>
<%@ page import="co.kozao.jcmsplugin.squashtm.model.squashimport.ImportSquashTmComparisonItem" %> 

        <%
        String selectionError = squashTmImportHandler.getSelectionError();
        if (selectionError != null && !selectionError.trim().isEmpty()) {
        	
        %>
            <div class="alert alert-danger squashtm-analysis-alert" id="squashTmSelectionError">
                <%= selectionError.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;") %>
            </div>
        <% } %>
  
  
 <%-- En-tête --%>
<div class="squashtm-analysis-header">
    <h2 class="squashtm-analysis-title">
      <span class="jalios-icon icomoon-file-excel"></span>
      <%= glp("jcmsplugin.squashtm.app.import.analysis.title") %>
    </h2>
    <p> <%= glp("jcmsplugin.squashtm.app.import.analysis.description") %> </p>
    <p>
      <strong> <%= glp("jcmsplugin.squashtm.app.import.analysis.Projets") %> </strong>
	      <span id="squashTmAnalysisProjectName">
	       	  <%= squashTmImportHandler.getImportAnalysis() != null ? squashTmImportHandler.getImportAnalysis().getProjectName() : "" %>
	      </span>
    </p>
</div>

  <%-- Statistiques --%>
<div class="squashtm-analysis-statistics">

    <div class="squashtm-analysis-stat-card">
      <span> <%= glp("jcmsplugin.squashtm.app.import.analysis.detected-lines") %> </span>
	      <strong id="squashTmAnalysisDetected">
	        <%= squashTmImportHandler.getImportAnalysis() != null ? squashTmImportHandler.getImportAnalysis().getDetectedLineCount() : 0 %>
	      </strong>
    </div>

    <div class="squashtm-analysis-stat-card">
      <span> <%= glp("jcmsplugin.squashtm.app.import.analysis.valid-lines") %> </span>
	      <strong id="squashTmAnalysisValid">
	        <%= squashTmImportHandler.getImportAnalysis() != null ? squashTmImportHandler.getImportAnalysis().getValidLineCount() : 0 %>
	      </strong>
    </div>

    <div class="squashtm-analysis-stat-card">
      <span> <%= glp("jcmsplugin.squashtm.app.import.analysis.anomalous-lines") %> </span>
	      <strong id="squashTmAnalysisAnomalous">
	        <%= squashTmImportHandler.getImportAnalysis() != null ? squashTmImportHandler.getImportAnalysis().getAnomalousLineCount() : 0 %>
	      </strong>
    </div>

    <div class="squashtm-analysis-stat-card">
      <span> <%= glp("jcmsplugin.squashtm.app.import.analysis.duplicate-lines") %> </span>
	      <strong id="squashTmAnalysisDuplicates">
	        <%= squashTmImportHandler.getImportAnalysis() != null ? squashTmImportHandler.getImportAnalysis().getDuplicateLineCount() : 0 %>
	      </strong>
    </div>

</div>

  <%-- Taux de validité --%>
  <div class="squashtm-analysis-validity">
    <strong> <%= glp("jcmsplugin.squashtm.app.import.analysis.validity-rate") %> </strong>
	    <span id="squashTmAnalysisValidityRate">
	      <%= squashTmImportHandler.getFormattedValidityRate() %> %
	    </span>
  </div>
  
  <%-- Résultat de la comparaison avec Squash TM --%>
<%
ImportSquashTmAnalysis analysis = squashTmImportHandler.getImportAnalysis();
%>

<% if (analysis != null && analysis.isExistingProject() && analysis.hasActionsToPerform()) { %>

		<% String allLabel = glp("jcmsplugin.squashtm.app.import.analysis.comparison.filter.all");
		
		java.util.List<String> rowStatusLabels = new java.util.ArrayList<String>();
		java.util.List<String> rowTypeLabels = new java.util.ArrayList<String>();
		
		java.util.LinkedHashSet<String> statusFilterValues = new java.util.LinkedHashSet<String>();
		java.util.LinkedHashSet<String> typeFilterValues = new java.util.LinkedHashSet<String>();
		
		statusFilterValues.add(allLabel);
		typeFilterValues.add(allLabel);
		
		for (ImportSquashTmComparisonItem candidate : analysis.getComparisonItems()) {
		
		    boolean candidateCreation = ImportSquashTmComparisonItem.STATUS_EXCEL_ONLY.equals(candidate.getStatus());
		    boolean candidateRename = ImportSquashTmComparisonItem.STATUS_RENAME.equals(candidate.getStatus());
		
		    if (!candidateCreation && !candidateRename) {
		        continue;
		    }
		
		    String candidateType = candidate.getElementType();
		    boolean candidateStep = ImportSquashTmComparisonItem.TYPE_TEST_STEP.equals(candidateType);
		
		    String candidateStatusLabel;
		
		    if (candidateRename && !candidateStep) {
		        candidateStatusLabel = glp("jcmsplugin.squashtm.app.import.analysis.comparison.rename-proposed");
		    } else if (candidateRename) {
		        candidateStatusLabel = glp("jcmsplugin.squashtm.app.import.analysis.comparison.update-proposed");
		    } else {
		        candidateStatusLabel = glp("jcmsplugin.squashtm.app.import.analysis.comparison.creation-proposed");
		    }
		
		    String candidateTypeLabel = "";
		
		    if (ImportSquashTmComparisonItem.TYPE_REQUIREMENT_FOLDER.equals(candidateType)) {
		        candidateTypeLabel = glp("jcmsplugin.squashtm.app.import.analysis.comparison.requirement-folder");
		    } else if (ImportSquashTmComparisonItem.TYPE_TEST_CASE_FOLDER.equals(candidateType)) {
		        candidateTypeLabel = glp("jcmsplugin.squashtm.app.import.analysis.comparison.testcase-folder");
		    } else if (ImportSquashTmComparisonItem.TYPE_REQUIREMENT.equals(candidateType)) {
		        candidateTypeLabel = glp("jcmsplugin.squashtm.app.import.analysis.comparison.requirement");
		    } else if (ImportSquashTmComparisonItem.TYPE_TEST_CASE.equals(candidateType)) {
		        candidateTypeLabel = glp("jcmsplugin.squashtm.app.import.analysis.comparison.testcase");
		    } else if (candidateStep) {
		        candidateTypeLabel = glp("jcmsplugin.squashtm.app.import.analysis.comparison.teststep");
		    }
		
		    rowStatusLabels.add(candidateStatusLabel);
		    rowTypeLabels.add(candidateTypeLabel);
		
		    statusFilterValues.add(candidateStatusLabel);
		
		    if (!candidateTypeLabel.isEmpty()) {
		        typeFilterValues.add(candidateTypeLabel);
		    }
		}
		
		String[] statusFilterOptions = statusFilterValues.toArray(new String[0]);
		String[] typeFilterOptions = typeFilterValues.toArray(new String[0]); %>

    <div class="squashtm-analysis-comparison">

	    <div class="squashtm-comparison-header">
            <h3> <span class="jalios-icon icomoon-compare"></span>
                <%= glp("jcmsplugin.squashtm.app.import.analysis.comparison.title") %>
            </h3>
        </div>
	
	    <div class="alert alert-warning squashtm-comparison-instructions" role="alert">
    		<span class="jalios-icon icomoon-warning"></span>
   			 <%= glp("jcmsplugin.squashtm.app.import.analysis.comparison.selection-description") %>
		</div>
				
		<div id="squashTmComparisonSelectionError" class="alert alert-warning squashtm-comparison-selection-error" role="alert" style="<%= squashTmImportHandler.isComparisonSelectionError() ? "display:block;" : "display:none;" %>">	
		    <%= glp("jcmsplugin.squashtm.app.import.analysis.comparison.selection-required") %>
		</div>
		
		<div id="squashTmComparisonFilters" class="squashtm-comparison-filters" data-all-label="<%= allLabel %>">

			    <jalios:field name="squashTmSelectAll" value="false" css="squashtm-filter-select-all">
			        <jalios:control settings='<%= new EnumerateSettings().checkbox().enumValues("true").enumLabels(glp("jcmsplugin.squashtm.app.import.analysis.comparison.filter.select-all")) %>' />
			    </jalios:field>
			
			    <jalios:field name="squashTmFilterToggle" label='<%= glp("jcmsplugin.squashtm.app.import.analysis.comparison.filter.toggle") %>' value="false" css="squashtm-filter-toggle">		
			        <jalios:control settings='<%= new BooleanSettings() %>' />
			    </jalios:field>
	
			    <div id="squashTmFilters" class="squashtm-filters" style="display:none;">
			
			        <jalios:field name="squashTmFilterType" label='<%= glp("jcmsplugin.squashtm.app.import.analysis.comparison.filter.data") %>' value='<%= allLabel %>' required="true" css="squashtm-filter-type">		
			            <jalios:control settings='<%= new EnumerateSettings().select().enumValues(typeFilterOptions) %>' />
			        </jalios:field>
			
			        <jalios:field name="squashTmFilterStatus" label='<%= glp("jcmsplugin.squashtm.app.import.analysis.comparison.filter.state") %>' value='<%= allLabel %>' required="true" css="squashtm-filter-status">		
			            <jalios:control settings='<%= new EnumerateSettings().select().enumValues(statusFilterOptions) %>' />
			        </jalios:field>
			
			    </div>
		 </div>

        <ul class="list-group">

            <%
            int comparisonIndex = 0;
            int rowPosition = 0;
            for (ImportSquashTmComparisonItem item : analysis.getComparisonItems()) {

                int currentIndex = comparisonIndex++;
                boolean isCreation = ImportSquashTmComparisonItem.STATUS_EXCEL_ONLY.equals(item.getStatus());
                boolean isRename = ImportSquashTmComparisonItem.STATUS_RENAME.equals(item.getStatus());

                if (!isCreation && !isRename) {
                    continue;
                }

                boolean isStep = ImportSquashTmComparisonItem.TYPE_TEST_STEP.equals(item.getElementType());
                String type = item.getElementType();
                String rowStatus = rowStatusLabels.get(rowPosition) .replace("&", "&amp;").replace("\"", "&quot;").replace("<", "&lt;").replace(">", "&gt;");
                String rowType = rowTypeLabels.get(rowPosition) .replace("&", "&amp;").replace("\"", "&quot;").replace("<", "&lt;").replace(">", "&gt;");
                rowPosition++;
            %>

               <li class="list-group-item squashtm-comparison-row" data-status="<%= rowStatus %>" data-type="<%= rowType %>">

                    <div class="squashtm-comparison-item">

                        <label class="squashtm-comparison-selection">
                            <input type="checkbox" class="squashtm-comparison-select" value="<%= currentIndex %>" />

                            <span class="squashtm-comparison-selection-content">
                                <span class="squashtm-comparison-line">
                                    <span class="squashtm-comparison-status">
                                        <% if (isRename && !isStep) { %>
                                            <span class="label label-warning">
                                                <%= glp("jcmsplugin.squashtm.app.import.analysis.comparison.rename-proposed") %>
                                            </span>
                                        <% } else { %>
                                            <span class="label label-info">
                                                <%= isRename ? glp("jcmsplugin.squashtm.app.import.analysis.comparison.update-proposed") : glp("jcmsplugin.squashtm.app.import.analysis.comparison.creation-proposed") %>
                                            </span>
                                        <% } %>
                                    </span>

                                    <% if (isRename && !isStep) { %>
                                        <span class="squashtm-comparison-name" itle="<%= glp("jcmsplugin.squashtm.app.import.analysis.comparison.original-name") %> : <%= item.getOriginalName() %> → <%= glp("jcmsplugin.squashtm.app.import.analysis.comparison.new-name") %> : <%= item.getElementName() %>">
                                            <span class="squashtm-comparison-old"><%= item.getOriginalName() %></span>
                                            <span class="squashtm-comparison-arrow">→</span>
                                            <strong><%= item.getElementName() %></strong>
                                        </span>
                                    <% } else { %>
                                        <span class="squashtm-comparison-name" title="<%= item.getElementName() %>">
                                            <strong><%= item.getElementName() %></strong>
                                        </span>
                                    <% } %>

 									<span class="squashtm-comparison-type <%= ImportSquashTmComparisonItem.TYPE_REQUIREMENT.equals(type) ? "comparison-type-requirement" :
    										ImportSquashTmComparisonItem.TYPE_TEST_CASE.equals(type) ? "comparison-type-testcase" : isStep ? "comparison-type-teststep" : "" %>">
	                                  		 <%
	
	                                        if (ImportSquashTmComparisonItem.TYPE_REQUIREMENT_FOLDER.equals(type)) {
	                                            out.print(glp("jcmsplugin.squashtm.app.import.analysis.comparison.requirement-folder"));
	
	                                        } else if (ImportSquashTmComparisonItem.TYPE_TEST_CASE_FOLDER.equals(type)) {
	                                            out.print(glp("jcmsplugin.squashtm.app.import.analysis.comparison.testcase-folder"));
	
	                                        } else if (ImportSquashTmComparisonItem.TYPE_REQUIREMENT.equals(type)) {
	                                            out.print(glp("jcmsplugin.squashtm.app.import.analysis.comparison.requirement"));
	
	                                        } else if (ImportSquashTmComparisonItem.TYPE_TEST_CASE.equals(type)) {
	                                            out.print(glp("jcmsplugin.squashtm.app.import.analysis.comparison.testcase"));
	
	                                        } else if (isStep) {
	                                            out.print(glp("jcmsplugin.squashtm.app.import.analysis.comparison.teststep"));
	                                        }
	                                        %>
                                    </span>

                                </span>

                                <span class="squashtm-comparison-path" title="<%= item.getElementPath() %>">
                                    <%= item.getElementPath() %>
                                </span>

                                <% if (isStep && item.getDifferences() != null && !item.getDifferences().isEmpty()) { %>
                                    <span class="squashtm-comparison-differences">
                                        <% for (String difference : item.getDifferences()) { %>
                                            <span class="squashtm-comparison-difference"><%= difference == null ? "" : difference.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;") %></span>
                                        <% } %>
                                    </span>
                                <% } %>

                            </span>

                        </label>

                    </div>

                </li>

                 <% } %>

            	<li id="squashTmComparisonEmpty" class="list-group-item squashtm-comparison-empty" style="display:none;">
                <%= glp("jcmsplugin.squashtm.app.import.analysis.comparison.filter.no-result") %>

            </li>

        </ul>

    </div>

<% } %>

  <%-- Liste des incohérences --%>
<div class="squashtm-analysis-inconsistencies">
    <h3> <%= glp("jcmsplugin.squashtm.app.import.analysis.inconsistencies") %> </h3>
   		 <% if (squashTmImportHandler.getImportAnalysis() != null && !squashTmImportHandler.getImportAnalysis() .getInconsistencies().isEmpty()) { %>
      <ul class="list-group">
        <% for (String inconsistency : squashTmImportHandler.getImportAnalysis() .getInconsistencies()) { %>
          <li class="list-group-item">
            <span class="jalios-icon icomoon-warning"></span>
            <%= inconsistency %>
          </li>
        <% } %>
      </ul>
    <% } else { %>
      <div class="alert alert-success">
        <%= glp("jcmsplugin.squashtm.app.import.analysis.no-inconsistencies") %>
      </div>
    <% } %>
</div>

  <%-- Erreurs de traitement --%>
<%
ImportSquashTmResult analysisResult = squashTmImportHandler.getImportResult();

if (analysisResult != null
        && squashTmImportHandler.getImportJobId() == null
        && analysisResult.getTechnicalErrors() != null
        && !analysisResult.getTechnicalErrors().isEmpty()) {
%>
<div class="squashtm-analysis-errors">
    <% for (String analysisError : analysisResult.getTechnicalErrors()) { %>
        <div class="alert alert-danger squashtm-analysis-alert">
            <%= analysisError == null ? "" : analysisError.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;") %>
        </div>
    <% } %>
</div>
<% } %>

  <%-- Boutons d'action --%>
  <div class="squashtm-analysis-actions">
    <button type="submit" id="squashTmCancelAnalysisButton" class="btn btn-default">
      	<span class="jalios-icon icomoon-close"></span>
     	   <%= glp("jcmsplugin.squashtm.app.import.cancel") %>
    </button>

    <button type="submit" id="squashTmConfirmImportButton" class="btn btn-primary">
      <span class="jalios-icon icomoon-upload"></span>
          <%= glp("jcmsplugin.squashtm.app.import.analysis.confirm") %>
    </button>
  </div>
  