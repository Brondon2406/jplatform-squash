					<div data-role="chart"></div>
				</div>
				<div class="sqd-panel-rep" data-panel="byProject">
					<h4><%= glp("jcmsplugin.squashtm.dashboard.chart.byProject") %></h4>
					<div data-role="chart"></div>
				</div>
				</div>

			<div class="sqd-table-wrap" data-role="table-wrap">
				<table class="sqd-table">
					<thead>
						<tr>
							<th scope="col" aria-sort="none" data-col="name" data-type="" data-cls="is-name"><button type="button" class="sqd-collapse" data-toggle-table aria-expanded="true" aria-label="Toggle"></button><button type="button" data-sort="name" data-table="reporting"><%= glp("jcmsplugin.squashtm.dashboard.col.name") %></button></th>
							<th scope="col" aria-sort="none" data-col="project" data-type=""><button type="button" data-sort="project" data-table="reporting"><%= glp("jcmsplugin.squashtm.dashboard.col.project") %></button></th>
							<th scope="col" aria-sort="none" data-col="type" data-type="value"><button type="button" data-sort="type" data-table="reporting"><%= glp("jcmsplugin.squashtm.dashboard.col.type") %></button></th>
							<th scope="col" aria-sort="none" class="is-number" data-col="id" data-type="number"><button type="button" data-sort="id" data-table="reporting"><%= glp("jcmsplugin.squashtm.dashboard.col.id") %></button></th>
						</tr>
					</thead>
					<tbody></tbody>
				</table>
			</div>
			<p class="sqd-empty" data-role="table-empty" hidden><%= glp("jcmsplugin.squashtm.dashboard.table.empty") %></p>
			<p class="sqd-table-note" data-role="table-note" hidden></p>

			</div>
		</section>
	</div>
</div>