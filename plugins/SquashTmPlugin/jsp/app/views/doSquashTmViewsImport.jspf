<%@ page contentType="text/html; charset=UTF-8" %><%
%><jsp:useBean id="squashTmImportHandler" scope="request" class="co.kozao.jcmsplugin.squashtm.handler.SquashTmImportHandler"><%
%><jsp:setProperty name="squashTmImportHandler" property="request"       value="<%= request %>"/><%
%><jsp:setProperty name="squashTmImportHandler" property="response"      value="<%= response %>"/><%
%><jsp:setProperty name="squashTmImportHandler" property="*" /><%
%></jsp:useBean>

<%
    if (squashTmImportHandler.validate()) {
        return;
    }

System.out.println( "[DEBUG JSP] importJobId = " + squashTmImportHandler.getImportJobId() );
%>

  <form action="" method="post" enctype="multipart/form-data" name="squashTmImportForm" id="squashTmImportForm" data-analysis-ready="<%= squashTmImportHandler.getImportAnalysis() != null %>" data-import-completed="<%= squashTmImportHandler.getImportResult() != null %>" 
	      data-import-job-id="<%= squashTmImportHandler.getImportJobId() != null ? squashTmImportHandler.getImportJobId() : "" %>">
	 <input type="hidden" id="opAnalyze" name="opAnalyze" value="false" />
	 <input type="hidden" id="opImport" name="opImport" value="false" />
	 <input type="hidden" id="opCancelAnalysis" name="opCancelAnalysis" value="false" />
	 <input type="hidden" id="analysisId" name="analysisId" value="<%= squashTmImportHandler.getAnalysisId() != null ? squashTmImportHandler.getAnalysisId() : "" %>" />
            
     <%-- ============== VUE D'IMPORT ============== --%> 
	<div class="squashtm-import-container">
	<%@ include file="/plugins/SquashTmPlugin/jsp/app/views/doSquashTmImportFiles.jspf" %>	
	</div>
	
	<%-- ============== SYNTHESE DE L'ANALYSE ============== --%>
	<div id="squashTmAnalysisContainer" class="squashtm-analysis-container" style="display: none;">
		<%@ include file="/plugins/SquashTmPlugin/jsp/app/views/doSquashTmImportAnalysis.jspf" %>
	</div>
	
	<%-- ============== RAPPORT FINAL D'IMPORTATION ============== --%>
	<div id="squashTmImportReport" class="squashtm-import-report" style="display: none;">
		<%@ include file="/plugins/SquashTmPlugin/jsp/app/views/doSquashTmImportReport.jspf" %> 
	</div>
</form>
