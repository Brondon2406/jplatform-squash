<%@ page import="co.kozao.jcmsplugin.squashtm.util.SquashTmManager" %>
<%@ page import="co.kozao.jcmsplugin.squashtm.model.api.LoggedUserInfo" %>
<%@ page import="com.jalios.jcms.uicomponent.app.*" %><%
%><%@ include file="/front/app/doAppCommon.jspf" %><%
%><jsp:useBean id="appHandler" scope="page" class="co.kozao.jcmsplugin.squashtm.handler.SquashTmAppHandler"><%
%><jsp:setProperty name="appHandler" property="request"       value="<%= request %>"/><%
%><jsp:setProperty name="appHandler" property="response"      value="<%= response %>"/><%
%><jsp:setProperty name="appHandler" property="*" /><%
%></jsp:useBean><%

if(appHandler.validate()){
	return;
}
String appUrl = appHandler.getAppUrl();
SquashTmManager sqTmManager = SquashTmManager.getInstance();
LoggedUserInfo loggedUserInfo = sqTmManager.getLoggedUserInfo();

jcmsContext.setPageTitle(glp("jcmsplugin.squashtm.app.label.title"));
jcmsContext.addCSSHeader("plugins/SquashTmPlugin/css");
jcmsContext.addJavaScript("plugins/SquashTmPlugin/js");
%>

<%@ include file='/jcore/doHeader.jspf'%>
<div class="ajax-refresh-div" datajalios-refresh-url="plugins/SquashTmPlugin/jsp/app/squashTm.jsp">
	<jalios:app name="squashTm" collapsedSidebar="false" collapsableSidebar="false">
	
	<% if (!sqTmManager.canConnectToSquashTm(loggedMember)) { %>
	<jalios:message  dismissable="false" css="gedbox-unifiedInsert-message" level="<%= MessageLevel.WARN %>">
	  <p><%=glp("jcmsplugin.squashtm.msg.cannot-connect-to-squash")%><br/> </p>
	 </jalios:message> 
 <% } else { %>
 	  <%
 	 	request.setAttribute("jcmsplugin.squashtm.token.is-connect", SquashTmManager.getInstance().isConnect());
 	  %>

		<%-- SIDEBAR --%>
		 <%@ include file='/plugins/SquashTmPlugin/jsp/app/sidebar/doSquashTmSidebar.jspf'%> 

		<%-- MAIN --%>
		<jalios:appMain headerTitle="<%= appHandler.getAppTitle() %>">
			<%@ include file='/plugins/SquashTmPlugin/jsp/app/body/doSquashTmBody.jspf'%>
		</jalios:appMain>
		
	 <% } %>
	 
	</jalios:app>

</div>

<%@ include file='/jcore/doAjaxFooter.jspf' %>